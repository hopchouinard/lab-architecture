---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
---
<Layout title="Overview" active="overview">
  <p class="kicker">Patchoutech · Architecture</p>
  <h1 class="hero">A home lab that operates itself — under a hard ceiling.</h1>
  <p class="stand">Three boundaries, one source of truth, zero secrets shipped.</p>

  <p class="lede">
    This is a white paper you can <em>explore</em>. The lab is split along a single seam:
    one repository <em>describes</em> what exists, a second <em>operates</em> it under a
    governed-autonomy model, and this site — the third boundary — <em>publishes</em> an
    account of both that anyone can read. None of the lab's data crosses into this site at
    all.
  </p>

  <hr class="rule" />

  <div class="stats">
    <div class="stat"><div class="n">3</div><div class="l">Boundaries</div></div>
    <div class="stat"><div class="n">1</div><div class="l">Source of truth</div></div>
    <div class="stat"><div class="n">0</div><div class="l">Secrets shipped</div></div>
  </div>

  <p class="next">Read it as a paper from here, or jump in and <a href="/explorer">open the explorer</a>.</p>
  <PageNav active="overview" />
</Layout>

<style>
  .hero { font-size: 44px; line-height: 1.1; margin: 10px 0 8px; max-width: 640px; }
  .stand { font-family: var(--serif); font-style: italic; font-size: 21px; color: var(--text-tertiary); margin: 0 0 28px; }
  .lede { color: var(--text-secondary); font-size: 17px; line-height: 1.7; max-width: var(--content-max); }
  .rule { border: none; border-top: 1px solid var(--structural-dim); margin: 32px 0; max-width: var(--content-max); }
  .stats { display: flex; gap: 46px; }
  .stat .n { font-family: var(--serif); font-size: 42px; color: var(--copper); line-height: 1; }
  .stat .l { font-family: var(--mono); font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-tertiary); margin-top: 6px; }
  .next { color: var(--text-secondary); margin-top: 34px; }
</style>
