---
import Layout from "./Layout.astro";
import PageNav from "../components/PageNav.astro";

interface Props {
  title: string;
  active: string;
  kicker?: string;
  headline: string;
  stand?: string;
}
const { title, active, kicker, headline, stand } = Astro.props;
---
<Layout title={title} active={active}>
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="page-title">{headline}</h1>
  {stand && <p class="stand">{stand}</p>}
  <div class="prose"><slot /></div>
  <PageNav active={active} />
</Layout>

<style>
  .page-title { font-family: var(--serif); font-weight: 400; font-size: 42px; line-height: 1.12; letter-spacing: 0.3px; margin: 10px 0 8px; max-width: 660px; color: var(--text-primary); }
  .stand { font-family: var(--serif); font-style: italic; font-size: 21px; line-height: 1.4; color: var(--text-tertiary); margin: 0 0 30px; max-width: 600px; }

  .prose { max-width: var(--content-max); }
  .prose :global(p) { color: var(--text-secondary); font-size: 16.5px; line-height: 1.72; margin: 0 0 18px; }
  .prose :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1.2; color: var(--text-primary); margin: 46px 0 12px; }
  .prose :global(h3) { font-family: var(--serif); font-weight: 400; font-size: 22px; color: var(--text-primary); margin: 30px 0 8px; }
  .prose :global(a) { color: var(--copper); text-decoration: none; border-bottom: 1px solid var(--copper-dim); }
  .prose :global(a:hover) { color: var(--copper-highlight); border-color: var(--copper); }
  .prose :global(strong) { color: var(--text-primary); font-weight: 500; }
  .prose :global(em) { font-style: italic; }
  .prose :global(ul), .prose :global(ol) { color: var(--text-secondary); font-size: 16.5px; line-height: 1.7; padding-left: 22px; margin: 0 0 18px; }
  .prose :global(li) { margin: 0 0 7px; }
  .prose :global(li::marker) { color: var(--copper-dim); }
  .prose :global(code) { font-family: var(--mono); font-size: 13px; background: var(--canvas-elevated); border: 1px solid var(--structural-dim); border-radius: 4px; padding: 1px 5px; color: var(--copper-highlight); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--structural-dim); margin: 32px 0; }
  .prose :global(h2:first-child), .prose :global(p:first-child) { margin-top: 0; }
</style>
